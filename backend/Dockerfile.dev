# =============================================================================
# DEVELOPMENT DOCKERFILE
# =============================================================================
ARG PYTHON_VERSION=3.12-slim
FROM python:${PYTHON_VERSION}

# Prevent Python from buffering stdout/stderr (immediate log output)
# and prevent writing .pyc files into the mounted host directory
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on

WORKDIR /app

# 1. Install common system dependencies needed for compiling packages / debugging
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Create a non-root user matching typical host UID (1000)
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} devuser && \
    useradd -u ${UID} -g devuser -m -s /bin/bash devuser

# 3. Install Python dependencies
# (Done before copying app code to leverage Docker layer caching)
COPY requirements*.txt ./
RUN pip install --upgrade pip && \
    pip install -r requirements.txt \
    # Install dev requirements if the file exists:
    && if [ -f requirements-dev.txt ]; then pip install -r requirements-dev.txt; fi

# 4. Copy codebase and set permissions
COPY --chown=devuser:devuser . /app

# Switch to non-root user
USER devuser

EXPOSE 8000

# 5. Use CMD instead of ENTRYPOINT so you can easily override commands
# (e.g. docker run ... bash, pytest, python manage.py migrate)
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
