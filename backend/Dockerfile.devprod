# =============================================================================
# 1. BASE: Shared configuration & base image
# =============================================================================
ARG PYTHON_VERSION=3.12-slim
ARG RUNTIME_BASE=gcr.io/distroless/python3-debian12:nonroot@sha256:7d1042ce588ab97019fe95c24ffca7bc5a82ccdac572511d5e09bda4435c89c5

FROM python:${PYTHON_VERSION} AS base

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0

# Install shared system dependencies (e.g. Postgres client libs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# 2. DEVELOPMENT: Rich shell, dev tools, hot-reloading, UID matching
# =============================================================================
FROM base AS dev

# Install compilers & debugging utilities needed only in dev
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user matching host UID for smooth bind-mount permissions
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} devuser && \
    useradd -u ${UID} -g devuser -m -s /bin/bash devuser

# Install dependencies (cached)
COPY requirements*.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install -r requirements.txt && \
    if [ -f requirements-dev.txt ]; then pip install -r requirements-dev.txt; fi

# Copy application source
COPY --chown=devuser:devuser . /app

USER devuser
EXPOSE 8000

# Overridable command for local development
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]

# =============================================================================
# 3. BUILDER: Compiles dependencies for Production
# =============================================================================
FROM base AS builder

ARG SOURCE_DATE_EPOCH

# Build dependencies required to build binary wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Target installation into a standalone directory for distroless
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --target=/install -r requirements.txt

COPY . /app

# Normalize timestamps for reproducible builds
RUN find /install /app -exec touch -h --date="@${SOURCE_DATE_EPOCH:-0}" {} +

# =============================================================================
# 4. PRODUCTION (DISTROLESS): Minimal, hardened runtime
# =============================================================================
FROM ${RUNTIME_BASE} AS prod

ARG GIT_SHA=unknown
ARG VERSION=1.0.0
ARG MAINTAINER="bruce@bruceminanga.world"

LABEL org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.authors="${MAINTAINER}"

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0 \
    PYTHONPATH=/app/site-packages

# Distroless default non-root user (UID 65532)
USER nonroot:nonroot

# Copy packages and code from builder
COPY --chown=nonroot:nonroot --from=builder /install /app/site-packages
COPY --chown=nonroot:nonroot --from=builder /app /app

EXPOSE 8000

ENTRYPOINT ["/usr/bin/python3", "-m", "gunicorn", \
            "myproject.wsgi:application", \
            "--bind", "0.0.0.0:8000", \
            "--workers", "3", \
            "--timeout", "120"]
