# Nginx was upto 17Mbs, i replaced it with Pure Go static server with SPA fallback routing which is way
# more smaller and still serves me


# =============================================================================
# STAGE 1 — Frontend Builder
# =============================================================================
FROM --platform=$BUILDPLATFORM node:22.14.0-alpine@sha256:9bef0ef1e268f60627da9ba7d7605e8831d5b56ad07487d24d1aa386336d1944 AS frontend-builder

WORKDIR /app
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline
COPY . .
ENV NODE_ENV=production
RUN npm run build

# =============================================================================
# # STAGE 2 — Lightweight Go Static Server
# Replaces Nginx (~17.8MB) with a stripped Go binary on 'scratch' (~6MB total)
# Includes built-in SPA client-side fallback routing
# =============================================================================
FROM golang:alpine AS server-builder

WORKDIR /src

# Pure Go static server with SPA fallback routing
RUN cat << 'EOF' > main.go
package main

import (
	"net/http"
	"os"
	"path/filepath"
)

func main() {
	fs := http.Dir("/public")
	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		path := filepath.Join("/public", filepath.Clean(r.URL.Path))
		if _, err := os.Stat(path); os.IsNotExist(err) {
			http.ServeFile(w, r, "/public/index.html")
			return
		}
		http.FileServer(fs).ServeHTTP(w, r)
	})
	http.ListenAndServe(":8080", handler)
}
EOF

# Build stripped static binary (~4MB)
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /server main.go

# =============================================================================
# STAGE 3 — Final Runtime (FROM scratch)
# =============================================================================
FROM scratch AS runtime

COPY --from=server-builder /server /server
COPY --from=frontend-builder /app/dist /public

EXPOSE 8080
ENTRYPOINT ["/server"]
